<?xml version="1.0" encoding="utf-8"?>
<!--
    Practical 2 - Part 2, Option A: Smallest width qualifier (sw600dp).
    This file is loaded automatically by Android on devices whose smallest width is at
    least 600dp (e.g. a 7-inch tablet such as Nexus 10 / Pixel Tablet), instead of
    res/layout/activity_main.xml.
    The screen is split into two panes: the black strip and the responsive title on the
    left, the description, the four colour blocks and the buttons on the right.
    Text sizes and padding are larger to suit the bigger screen.
    Only match_parent / wrap_content / 0dp + weight / dp + sp are used - no hard-coded sizes.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#000000">

    <!-- 左侧面板：顶部黑色条 + 响应式布局标题 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 左侧面板 1/4：顶部黑色条 -->
        <TextView
            android:id="@+id/lab1Text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000"
            android:gravity="center"
            android:padding="24dp"
            android:text="Layout 1"
            android:textColor="#ffffff"
            android:textSize="24sp" />

        <!-- 左侧面板 3/4：响应式布局标题 -->
        <TextView
            android:id="@+id/responsiveTitleTextView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:background="#FFFFFF"
            android:gravity="center"
            android:padding="24dp"
            android:text="Responsive Layout 1"
            android:textColor="#000000"
            android:textSize="34sp" />

    </LinearLayout>

    <!-- 右侧面板：内容 + 四色块 + 按钮条 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 右侧面板 2/4：中间可变区域 -->
        <TextView
            android:id="@+id/contentTextView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:gravity="center"
            android:padding="24dp"
            android:text="Android Application"
            android:textColor="#FFFFFF"
            android:textSize="26sp" />

        <!-- 右侧面板 1/4：四色等宽块分组（组内仍是水平等分） -->
        <LinearLayout
            android:id="@+id/colorRowLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#FF0000"
                android:gravity="center"
                android:text="This"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#0000FF"
                android:gravity="center"
                android:text="is"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#800080"
                android:gravity="center"
                android:text="my"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#FFFF00"
                android:gravity="center"
                android:text="first"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

        </LinearLayout>

        <!-- 右侧面板 1/4：按钮条 -->
        <LinearLayout
            android:id="@+id/buttonBarLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:padding="24dp">

            <Button
                android:id="@+id/changeButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:backgroundTint="#7B68EE"
                android:text="Change"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <Button
                android:id="@+id/cancelButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:backgroundTint="#7B68EE"
                android:text="Cancel"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
